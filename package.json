{
  "name": "@maemreyo/pi-goal",
  "version": "0.2.0-zamery.1",
  "description": "Pi 1.0 compatibility fork of @schovest/pi-goal 0.2.0",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "goal",
    "automation"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtension": {
    "lifecycle": "stable"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.56.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.5",
    "@earendil-works/pi-coding-agent": "0.80.5",
    "@earendil-works/pi-tui": "0.80.5",
    "typebox": "^1.3.0",
    "@types/node": "22.20.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maemreyo/pi-goal.git"
  },
  "homepage": "https://github.com/maemreyo/pi-goal#readme",
  "bugs": {
    "url": "https://github.com/maemreyo/pi-goal/issues"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "verify:metadata": "node scripts/verify-package.mjs",
    "verify:provenance": "shasum -a 256 -c UPSTREAM_SRC_SHA256.txt",
    "test": "npm run verify:metadata && npm run verify:provenance && npm run typecheck"
  }
}
